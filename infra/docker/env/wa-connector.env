DATABASE_URL=postgres://wagi_app:${POSTGRES_PASSWORD:-app}@db:5432/${POSTGRES_DB:-app}?sslmode=${WA_DATABASE_SSLMODE:-disable}
NATS_URL=nats://nats:4222
WA_PORT=3001
WA_BACKFILL_DAYS=${WA_BACKFILL_DAYS:-7}
WA_BACKFILL_THROTTLE_MS=${WA_BACKFILL_THROTTLE_MS:-250}
WA_BACKFILL_GROUP_DELAY_MS=${WA_BACKFILL_GROUP_DELAY_MS:-1500}
WA_HISTORY_PAGE_SIZE=${WA_HISTORY_PAGE_SIZE:-50}
WA_HISTORY_REQUEST_DELAY_MS=${WA_HISTORY_REQUEST_DELAY_MS:-500}
WA_MEDIA_DOWNLOAD_ATTEMPTS=${WA_MEDIA_DOWNLOAD_ATTEMPTS:-3}
WA_MEDIA_RETRY_INTERVAL_MS=${WA_MEDIA_RETRY_INTERVAL_MS:-60000}
WA_SYNC_GRACE_SECONDS=${WA_SYNC_GRACE_SECONDS:-60}
WA_WHATSMEOW_SQL_SCHEMA=${WA_WHATSMEOW_SQL_SCHEMA:-wa_whatsmeow}
MEDIA_DIR=/data/media
MEDIA_CLEANUP_TOKEN=${MEDIA_CLEANUP_TOKEN:?MEDIA_CLEANUP_TOKEN must be set}
CONNECTOR_POOL_ENABLED=${CONNECTOR_POOL_ENABLED:-true}
CONNECTOR_ROLE=onboarding
WA_CONNECTOR_POOL_SIZE=${WA_CONNECTOR_POOL_SIZE:-5}
WA_ONBOARDING_SLOTS=${WA_ONBOARDING_SLOTS:-1}
CONNECTOR_SYNC_INTERVAL_SECONDS=${CONNECTOR_SYNC_INTERVAL_SECONDS:-300}
CONNECTOR_WORKER_ID=${CONNECTOR_WORKER_ID:-}
CONNECTOR_ACCOUNT_ID=${WA_CONNECTOR_ACCOUNT_ID:-}
CONNECTOR_LEASE_SECONDS=${CONNECTOR_LEASE_SECONDS:-90}
CONNECTOR_ACCOUNT_SLOT_SECONDS=${CONNECTOR_ACCOUNT_SLOT_SECONDS:-1800}
