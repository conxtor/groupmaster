DATABASE_URL=postgres://wagi_app:${POSTGRES_PASSWORD:-app}@db:5432/${POSTGRES_DB:-app}?sslmode=disable
NATS_URL=nats://nats:4222
PORT=8080
MEDIA_DIR=/data/media
MEDIA_SIGNING_SECRET=${MEDIA_SIGNING_SECRET:-}
MEDIA_CLEANUP_TOKEN=${MEDIA_CLEANUP_TOKEN:?MEDIA_CLEANUP_TOKEN must be set}
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER:-minio}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD:-miniosecret}
MINIO_BUCKET=${MINIO_BUCKET:-wa-media}
MINIO_BUCKET_IMAGES=${MINIO_BUCKET_IMAGES:-wa-media-images}
MINIO_BUCKET_VIDEOS=${MINIO_BUCKET_VIDEOS:-wa-media-videos}
MINIO_BUCKET_AUDIO=${MINIO_BUCKET_AUDIO:-wa-media-audio}
MINIO_BUCKET_DOCUMENTS=${MINIO_BUCKET_DOCUMENTS:-wa-media-documents}
MINIO_BUCKET_OTHER=${MINIO_BUCKET_OTHER:-wa-media-other}
MEDIA_BUCKET_MIGRATION_ENABLED=${MEDIA_BUCKET_MIGRATION_ENABLED:-true}
WAGI_CORS_ORIGIN=${WAGI_CORS_ORIGIN:-}
WAGI_COOKIE_SECURE=${WAGI_COOKIE_SECURE:-false}
WAGI_PUBLIC_URL=${WAGI_PUBLIC_URL:-http://localhost:3000}
WAGI_BOOTSTRAP_ADMIN_EMAIL=${WAGI_BOOTSTRAP_ADMIN_EMAIL:-volker@kerkhoff.es}
WAGI_BOOTSTRAP_ADMIN_NAME=${WAGI_BOOTSTRAP_ADMIN_NAME:-Volker Kerkhoff}
WAGI_BOOTSTRAP_ADMIN_PASSWORD=${WAGI_BOOTSTRAP_ADMIN_PASSWORD:-}
SMTP_ENABLED=${SMTP_ENABLED:-false}
SMTP_HOST=${SMTP_HOST:-}
SMTP_PORT=${SMTP_PORT:-587}
SMTP_USERNAME=${SMTP_USERNAME:-}
SMTP_PASSWORD=${SMTP_PASSWORD:-}
SMTP_USE_TLS=${SMTP_USE_TLS:-true}
SMTP_USE_SSL=${SMTP_USE_SSL:-false}
SMTP_FROM_EMAIL=${SMTP_FROM_EMAIL:-}
SMTP_FROM_NAME=${SMTP_FROM_NAME:-WAGI}
SMTP_REPLY_TO=${SMTP_REPLY_TO:-}
EMAIL_VERIFICATION_HOURS=${EMAIL_VERIFICATION_HOURS:-48}
PASSWORD_RESET_HOURS=${PASSWORD_RESET_HOURS:-1}
WA_CONNECTOR_POOL_SIZE=${WA_CONNECTOR_POOL_SIZE:-5}
TG_CONNECTOR_POOL_SIZE=${TG_CONNECTOR_POOL_SIZE:-5}
WA_ONBOARDING_SLOTS=${WA_ONBOARDING_SLOTS:-1}
TG_ONBOARDING_SLOTS=${TG_ONBOARDING_SLOTS:-1}
