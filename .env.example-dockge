# Copy to .env-dockge and replace all REPLACE_ME values.
# Dockge must use this file as the stack environment file.

# GHCR images published by .github/workflows/publish-ghcr.yml
GHCR_IMAGE_OWNER=conxtor
GHCR_IMAGE_TAG=latest

# Public hostname and Traefik entrypoint used by the Docker labels.
TRAEFIK_HOST=conxtor.com
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
API_INTERNAL_URL=http://api:8080

# PostgreSQL and application database credentials.
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=REPLACE_ME_postgres_superuser_password
POSTGRES_DB=app
WAGI_DB_PASSWORD=REPLACE_ME_url_safe_app_database_password

# Application secrets. Use long random URL-safe values.
MEDIA_SIGNING_SECRET=REPLACE_ME_media_signing_secret
MEDIA_CLEANUP_TOKEN=REPLACE_ME_media_cleanup_token
WAGI_COOKIE_SECURE=true
WAGI_CORS_ORIGIN=
WAGI_PUBLIC_URL=https://conxtor.com
WAGI_BOOTSTRAP_ADMIN_EMAIL=volker@kerkhoff.es
WAGI_BOOTSTRAP_ADMIN_NAME=Volker Kerkhoff
WAGI_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_admin_password

# Email delivery. Mailcow: use the reachable Mailcow SMTP hostname and port 587.
SMTP_ENABLED=true
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@conxtor.com
SMTP_PASSWORD=REPLACE_ME_mailbox_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@conxtor.com
SMTP_FROM_NAME=WAGI
SMTP_REPLY_TO=
EMAIL_VERIFICATION_HOURS=48
PASSWORD_RESET_HOURS=1

# Private MinIO storage. MinIO is not published through Traefik.
MINIO_ROOT_USER=REPLACE_ME_minio_user
MINIO_ROOT_PASSWORD=REPLACE_ME_minio_password
# The bucket is created idempotently by media-worker before first use.
MINIO_BUCKET=wa-media

# Connector pool and first backfill.
CONNECTOR_POOL_ENABLED=true
WA_CONNECTOR_POOL_SIZE=5
TG_CONNECTOR_POOL_SIZE=5
WA_ONBOARDING_SLOTS=1
TG_ONBOARDING_SLOTS=1
CONNECTOR_LEASE_SECONDS=90
CONNECTOR_ACCOUNT_SLOT_SECONDS=1800
CONNECTOR_SYNC_INTERVAL_SECONDS=300
CONNECTOR_START_DELAY_MS=5000
CONNECTOR_POOL_RETRY_DELAY_MS=20000
CONNECTOR_WORKER_ID=
WA_CONNECTOR_ACCOUNT_ID=
TG_CONNECTOR_ACCOUNT_ID=

# WhatsApp Linked Device / Baileys.
WA_GROUP_ALLOWLIST=
WA_SYNC_HISTORY=false
WA_BACKFILL_DAYS=7
WA_BACKFILL_THROTTLE_MS=250
WA_BACKFILL_GROUP_DELAY_MS=1500
WA_HISTORY_PAGE_SIZE=50
WA_HISTORY_MAX_PAGES=20
WA_HISTORY_WAIT_MS=20000
WA_MEDIA_DOWNLOAD_TIMEOUT_MS=30000
WA_MEDIA_DOWNLOAD_ATTEMPTS=3
WA_MEDIA_RETRY_INTERVAL_MS=60000
GROUP_REFRESH_INTERVAL_MS=60000

# Telegram direct MTProto. TG_API_ID and TG_API_HASH are required for QR login.
TG_BOT_TOKEN=
TG_API_ID=
TG_API_HASH=
TG_PHONE=
TG_SESSION=
TG_GROUP_ALLOWLIST=
TG_BACKFILL_DAYS=7
TG_BACKFILL_THROTTLE_MS=500
TG_BACKFILL_GROUP_DELAY_MS=2000
TG_CONNECTION_RETRIES=12
TG_REQUEST_RETRIES=8
TG_DOWNLOAD_RETRIES=8
TG_RETRY_DELAY_MS=2000
TG_MEDIA_RETRY_ATTEMPTS=4
TG_POLL_TIMEOUT=25

# AI and Hermes-Agent. Leave Hermes disabled when local hybrid processing is preferred.
AI_MODEL=heuristic-mvp
AI_PROVIDER=hybrid
AI_ENDPOINT=
AI_API_KEY=
AI_PROMPT_VERSION=cascade-v4
AI_KNOWLEDGE_VERSION=cascade-v4
AI_CONTEXT_MAX_MESSAGES=80
AI_EVENT_WINDOW_HOURS=36
AI_EVENT_MIN_CONFIDENCE=0.70
AI_EMBEDDINGS_ENABLED=true
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_EMBEDDING_CACHE_DIR=/root/.cache/fastembed
AI_HF_MODEL_LOAD_INTERVAL_SECONDS=86400
HF_TOKEN=
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_ETAG_TIMEOUT=10
AI_SEMANTIC_DISCOVERY_THRESHOLD=0.84
AI_SEMANTIC_MERGE_THRESHOLD=0.18
AI_HERMES_ENABLED=false
AI_HERMES_URL=
AI_HERMES_API_KEY=
AI_HERMES_MODEL=hermes-agent
AI_HERMES_TIMEOUT_MS=60000
AI_HERMES_CONNECT_TIMEOUT_MS=10000
AI_HERMES_RETRY_ATTEMPTS=3
AI_HERMES_RETRY_BASE_MS=1500
AI_HERMES_RETRY_MAX_MS=10000
AI_HERMES_FAILURE_COOLDOWN_SECONDS=60
AI_HERMES_REVIEW_ALL=false
AI_HERMES_MIN_CONFIDENCE=0.78
AI_MAX_RETRIES=5
AI_STALE_PROCESSING_SECONDS=900
AI_DOCUMENT_ANALYSIS_MAX_CHARS=12000
AI_NATS_PAYLOAD_LIMIT_BYTES=900000

# Local whisper.cpp media processing.
WHISPER_ENABLED=true
WHISPER_MODEL=medium
WHISPER_LANGUAGE=auto
WHISPER_LANGUAGES=es,ca,de,en,fr
WHISPER_THREADS=4
MEDIA_MAX_RETRIES=3
MEDIA_STALE_PROCESSING_SECONDS=900
MEDIA_ANALYSIS_EVENT_MAX_CHARS=12000

# Same-origin routing: the browser uses https://conxtor.com/api/ through Traefik.
NEXT_PUBLIC_API_URL=
NATS_EVENT_MAX_AGE_DAYS=30
NATS_DLQ_MAX_AGE_DAYS=90
NATS_MAX_DELIVERIES=5
NATS_RETRY_BASE_SECONDS=5
NATS_RETRY_MAX_SECONDS=300
