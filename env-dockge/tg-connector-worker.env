DATABASE_URL=postgres://wagi_app:${WAGI_DB_PASSWORD}@postgres:5432/${POSTGRES_DB:-app}
NATS_URL=nats://nats:4222
TG_PORT=3002
TG_STATE_DIR=/data/tg-state
TG_API_ID=${TG_API_ID:-}
TG_API_HASH=${TG_API_HASH:-}
TG_BACKFILL_DAYS=${TG_BACKFILL_DAYS:-7}
TG_BACKFILL_THROTTLE_MS=${TG_BACKFILL_THROTTLE_MS:-500}
TG_BACKFILL_GROUP_DELAY_MS=${TG_BACKFILL_GROUP_DELAY_MS:-2000}
GROUP_REFRESH_INTERVAL_MS=${GROUP_REFRESH_INTERVAL_MS:-60000}
MEDIA_DIR=/data/media
MEDIA_CLEANUP_TOKEN=${MEDIA_CLEANUP_TOKEN}
CONNECTOR_POOL_ENABLED=${CONNECTOR_POOL_ENABLED:-true}
CONNECTOR_ROLE=processing
TG_CONNECTOR_POOL_SIZE=${TG_CONNECTOR_POOL_SIZE:-5}
TG_ONBOARDING_SLOTS=${TG_ONBOARDING_SLOTS:-1}
CONNECTOR_SYNC_INTERVAL_SECONDS=${CONNECTOR_SYNC_INTERVAL_SECONDS:-300}
CONNECTOR_WORKER_ID=${CONNECTOR_WORKER_ID:-}
CONNECTOR_ACCOUNT_ID=${TG_CONNECTOR_ACCOUNT_ID:-}
CONNECTOR_LEASE_SECONDS=${CONNECTOR_LEASE_SECONDS:-90}
CONNECTOR_ACCOUNT_SLOT_SECONDS=${CONNECTOR_ACCOUNT_SLOT_SECONDS:-1800}
CONNECTOR_START_DELAY_MS=${CONNECTOR_START_DELAY_MS:-5000}
CONNECTOR_POOL_RETRY_DELAY_MS=${CONNECTOR_POOL_RETRY_DELAY_MS:-20000}
WAGI_BOOTSTRAP_ADMIN_EMAIL=${WAGI_BOOTSTRAP_ADMIN_EMAIL:-volker@kerkhoff.es}
