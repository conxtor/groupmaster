DATABASE_URL=postgres://wagi_app:${WAGI_DB_PASSWORD}@postgres:5432/${POSTGRES_DB:-app}
NATS_URL=nats://nats:4222
NATS_MAX_DELIVERIES=${NATS_MAX_DELIVERIES:-5}
NATS_RETRY_BASE_SECONDS=${NATS_RETRY_BASE_SECONDS:-5}
NATS_RETRY_MAX_SECONDS=${NATS_RETRY_MAX_SECONDS:-300}
MEDIA_ANALYSIS_EVENT_MAX_CHARS=${MEDIA_ANALYSIS_EVENT_MAX_CHARS:-12000}
WHISPER_ENABLED=${WHISPER_ENABLED:-true}
WHISPER_MODEL=${WHISPER_MODEL:-medium}
WHISPER_CPP_BIN=/usr/local/bin/whisper-cli
WHISPER_MODEL_PATH=/models/ggml-medium.bin
WHISPER_LANGUAGE=${WHISPER_LANGUAGE:-auto}
WHISPER_LANGUAGES=${WHISPER_LANGUAGES:-es,ca,de,en,fr}
WHISPER_THREADS=${WHISPER_THREADS:-4}
MEDIA_MAX_RETRIES=${MEDIA_MAX_RETRIES:-3}
MEDIA_STALE_PROCESSING_SECONDS=${MEDIA_STALE_PROCESSING_SECONDS:-900}
MEDIA_DIR=/data/media
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=${MINIO_BUCKET:-wa-media}
MINIO_BUCKET_IMAGES=${MINIO_BUCKET_IMAGES:-wa-media-images}
MINIO_BUCKET_VIDEOS=${MINIO_BUCKET_VIDEOS:-wa-media-videos}
MINIO_BUCKET_AUDIO=${MINIO_BUCKET_AUDIO:-wa-media-audio}
MINIO_BUCKET_DOCUMENTS=${MINIO_BUCKET_DOCUMENTS:-wa-media-documents}
MINIO_BUCKET_OTHER=${MINIO_BUCKET_OTHER:-wa-media-other}
MEDIA_CLEANUP_TOKEN=${MEDIA_CLEANUP_TOKEN}
