{
  "name": "wa-group-intelligence",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "npm@10.8.2",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@wagi/web",
    "dev:connector": "cd apps/wa-connector-go && go run .",
    "dev:telegram": "cd apps/tg-connector-go && go run ."
  }
}
