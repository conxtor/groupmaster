@startuml
title WAGI – Deployment: lokal und Dockge/Produktion
skinparam componentStyle rectangle
skinparam packageStyle rectangle

cloud "Internet" as Internet
cloud "Mailcow / SMTP-Provider\nextern oder intern erreichbar" as Mail
node "Lokaler Docker-Compose-Stack" as Local {
  node "Public Entry" {
    component "nginx:80\nWAGI_PUBLIC_PORT" as LocalNginx
  }
  component "web:3000\nNext.js standalone" as LocalWeb
  component "api:8080\nGo" as LocalAPI
  component "wa-connector:3001\nGo/whatsmeow\nOnboarding + Pool" as LocalWA
  component "tg-connector:3002\nGo/gotd MTProto Onboarding\nkein Bot-Fallback" as LocalTG
  component "wa-connector-worker\nGo/whatsmeow Processing" as LocalWAW
  component "tg-connector-worker\nGo/gotd Processing" as LocalTGW
  component "ai-worker\nPython 3.12-slim" as LocalAI
  component "media-worker\nPython 3.12-slim + whisper.cpp" as LocalMedia
  component "migrate\npostgres:15-alpine\nversionierte SQL-Migrationen" as LocalMigrate
  component "nats-provisioner\npython:3.12-alpine" as LocalProvisioner
  database "db\nPostgreSQL 15 + PostGIS/pgvector" as LocalDB
  queue "nats:4222\nJetStream /data/jetstream" as LocalNATS
  storage "minio:9000\nseparate media buckets" as LocalMinio
  component "SMTP-Konfiguration\n.env" as LocalSMTP
  folder "Named Volumes\nTG-State, Medien,\nWhisper- und AI-Modelle" as LocalVolumes
  database "wa_whatsmeow\nPostgreSQL-Schema\nkeine Auth-Dateien" as LocalMeowDB
}

node "Dockge / Produktionsserver" as Production {
  component "Traefik\nTLS + conxtor.com" as ProdTraefik
  component "web:3000\nöffentlich geroutet" as ProdWeb
  component "api:8080\ntraefik.enable=false" as ProdAPI
  component "wa-connector + worker\nGo/whatsmeow, kein Host-Port" as ProdWA
  component "tg-connector + worker\nGo/gotd MTProto, kein Bot-Fallback\nkein Host-Port" as ProdTG
  component "ai-worker" as ProdAI
  component "media-worker" as ProdMedia
  component "migrate + nats-provisioner\nEinmalige Jobs" as ProdInit
  database "postgres\ninterner Dienst" as ProdDB
  queue "nats\ninterner Dienst + JetStream" as ProdNATS
  storage "minio\ninterner Dienst\nseparate media buckets" as ProdMinio
  component "SMTP-Client\nAPI → Mailcow" as ProdSMTP
  folder "Named Volumes\nPersistente Sitzungen und Daten" as ProdVolumes
}

Internet --> ProdTraefik : HTTPS Host
ProdTraefik --> ProdWeb : conxtor.com
ProdWeb --> ProdAPI : API_INTERNAL_URL\nhttp://api:8080/api/*

LocalNginx --> LocalWeb : /
LocalNginx --> LocalAPI : /api/, /healthz, /readyz

LocalMigrate --> LocalDB : schema migrations
LocalProvisioner --> LocalNATS : streams + consumers
LocalWA --> LocalDB
LocalWAW --> LocalDB
LocalWA --> LocalMeowDB : whatsmeow SQLStore
LocalWA --> LocalDB : WAGI-Leases + Gruppen
LocalWA --> LocalNATS
LocalTG --> LocalDB
LocalTGW --> LocalDB
LocalWA --> LocalNATS
LocalWAW --> LocalNATS
LocalTG --> LocalNATS
LocalTGW --> LocalNATS
LocalAPI --> LocalDB
LocalAPI --> LocalNATS
LocalAI --> LocalDB
LocalAI --> LocalNATS
LocalMedia --> LocalDB
LocalMedia --> LocalNATS
LocalMedia --> LocalMinio : ensure bucket + media objects
LocalMedia --> LocalVolumes
LocalAPI --> LocalVolumes : signed media streaming
LocalAPI --> LocalSMTP : SMTP 587/465
LocalVolumes .. LocalWA
LocalVolumes .. LocalTG

ProdInit --> ProdDB : migrations
ProdInit --> ProdNATS : provisioning
ProdWA --> ProdDB
ProdWA --> ProdNATS
ProdWA --> ProdDB : SQLStore + Leases
ProdWA --> ProdNATS
ProdTG --> ProdDB
ProdTG --> ProdNATS
ProdAPI --> ProdDB
ProdAPI --> ProdNATS
ProdAI --> ProdDB
ProdAI --> ProdNATS
ProdMedia --> ProdDB
ProdMedia --> ProdNATS
ProdMedia --> ProdMinio : ensure bucket + media objects
ProdMedia --> ProdVolumes
ProdAPI --> ProdVolumes : read-only shared media
ProdAPI --> ProdSMTP : SMTP 587/465
ProdSMTP --> Mail : STARTTLS / implicit TLS

note right of ProdTraefik
  Nur web ist öffentlich.
  API, PostgreSQL, NATS, MinIO,
  Connectoren und Worker bleiben
  ohne Host-Portfreigabe intern.
end note

note right of ProdMedia
  Kein separater Bucket-Initialisierungs-Service.
  Der media-worker prüft und erstellt die
  typabhängigen Buckets vor Uploads und
  Cleanups idempotent.
  Die API startet optional die isolierte,
  wiederaufnehmbare Legacy-Migration.
end note

note right of Mail
  Mailcow wird nicht über WAGI-Traefik
  veröffentlicht. Nur der SMTP-Zielhost
  muss aus dem API-Container erreichbar sein.
  Verifizierungs- und Reset-Mails werden
  in der Sprache des Formulars versendet.
end note

note right of LocalProvisioner
  Kleine Basis-Images werden bevorzugt:
  Node.js, NATS, NGINX, Migration-Runner
  und dieser Provisioner verwenden Alpine.
  Die API läuft distroless. Python Slim
  bleibt für ONNX, Whisper und OCR wegen
  nativer Paketkompatibilität bestehen.
end note

note bottom of LocalVolumes
  Lokale Volumes:
  postgres_data, nats_data, minio_data,
  tg_state, whisper_models,
  media_data, ai_models.
  Dockge verwendet gleichwertige
  *_dockge Volumes.
end note
@enduml
