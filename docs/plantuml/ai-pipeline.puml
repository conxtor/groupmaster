@startuml
title WAGI – Medien- und AI-Pipeline
skinparam componentStyle rectangle

start
:Connector publiziert wa.messages.received;
:JetStream Durable Consumer\nWAGI_AI_MESSAGES liefert Event;
:event_inbox beansprucht Event idempotent;
:ai_jobs anlegen / Retrystatus setzen;
:Nachricht + zeitnahen Gruppenkontext\naus PostgreSQL laden;

if (Medientyp?) then (Audio)
  :media.audio.requested;
  :media-worker lädt lokale Quelle;
  :Quelle dauerhaft in MinIO /\nmedia_objects speichern;
  :whisper.cpp medium lokal ausführen\n(es, ca, de, en, fr; weitere aktivierbar);
  :media.audio.transcribed publizieren;
  :Transkript als vollständigen\nAnalysekontext übernehmen;
elseif (Bild)
  :media.objects.requested;
  :MinIO-Objekt + Thumbnail speichern;
  :Lokales OCR / Bildanalyse;
  :media.image.analyzed publizieren;
  :OCR-Kontext übernehmen;
elseif (Dokument)
  :media.objects.requested;
  :Originaldokument in MinIO speichern;
  :Lokale Dokumentextraktion / OCR;
  :Vollständigen Text in\nmedia_objects.ocr_text speichern;
  :media.document.analyzed publizieren;
  :Nur begrenzten Analyseauszug verwenden;\nOriginal bleibt über sicheren Media-Link verfügbar;
elseif (Video)
  :media.objects.requested;
  :Original + Vorschau in MinIO speichern;
else (Text / Ort)
  :Nachrichtentext direkt verwenden;
endif

:Sprache der Gruppe bestimmen;
:Globale und gruppengebundene Lernbegriffe\naus ai_learning_terms laden;
:Deterministische Heuristik-Kaskade ausführen;
:Relevanz und Relevance-Score;
:Facts und Entities extrahieren;
:Events über mehrere Nachrichten\nmit Quellenbelegen zusammenführen;
:Orte, Koordinaten und Widersprüche erkennen;
:Aktive Themen, Beschreibungen und\nTopic-/Detailbegriffe aus PostgreSQL laden;
:Oberthema aus datenbankbasierten\nBegriffen oder Embeddings bestimmen;
:Unterthema über Inhaltsüberschneidung\nmit Gruppenprofilen wiederverwenden oder neu anlegen;
:Aussagekräftigen Titel aus dem\nThreadinhalt ableiten;
:Neue Subtopic-Begriffe konservativ in\nknowledge_subtopic_terms lernen;
:Nur klar überlappende Quellnachrichten\nim Unterthema zusammenführen;

if (Embeddings aktiviert?) then (ja)
  :fastembed multilingual lokal laden\nund pgvector-Abgleich durchführen;
else (nein)
  :Lexikalische Heuristik verwenden;
endif

if (Hermes-Agent aktiviert?) then (ja)
  :Kandidaten an Hermes-Agent senden;
  if (Antwort gültig?) then (ja)
    :Accept / Reject / Review anwenden;
  else (nein)
    :Lokales Ergebnis behalten;\nRetry + Cooldown protokollieren;
  endif
else (nein)
  :Lokales Ergebnis behalten;
endif

:JSON-Schema, Provenance und\nKonfidenzen validieren;
:message_analyses, ai_jobs, Knowledge-Hierarchie\nund Graph sowie aktive Verarbeitungsdauer speichern;
:Queue-/Retry-Zeit getrennt von der\naktiven Worker-Zeit beobachten;
:Relevanz-, Event-, Orts- und\nKnowledge-Feedback in ai_learning_terms lernen;
:ai.messages.analyzed publizieren;

fork
  :Administrator startet Neubewertung;
  :ai.reassessment.requested in
  WAGI_REASSESSMENT lesen;
  :Gespeicherte Texte, Transkripte,
  OCR und Metadaten laden;
  :Kaskade mit aktuellen Lernbegriffen
  erneut ausführen;
  :message_analyses und Knowledge
  aktualisieren, keine Medienjobs;
fork again
  :Live-Nachrichten werden über
  WAGI_EVENTS unabhängig verarbeitet;
fork again
  :Administrator startet KB-Neuaufbau;
  :knowledge.rebuild.requested in
  WAGI_KB_REBUILD lesen;
  :Text, Transkript, OCR und Metadaten
  in neuer Generation analysieren;
  :Generation erst nach vollständigem Erfolg
  aktiv schalten; bei Fehler alte KB behalten;
end fork;

fork
  :Web/API liest Dashboard, Events\nund Knowledge Base aus PostgreSQL;
fork again
  :Bei Fehler: Backoff, event_inbox,\nevent_failures und DLQ-Eintrag;
fork again
  :Replay/Backfill kann ausgewählte\nZeiträume erneut anfordern;
end fork
stop
@enduml
