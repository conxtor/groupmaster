@startuml
title WAGI – Aktuelle Gesamtarchitektur
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle

actor "Authentifizierter Nutzer" as User
actor "Administrator" as Admin

package "Externe Messaging-Dienste" {
  cloud "WhatsApp Consumer Account" as WhatsApp
  cloud "Telegram Account\nMTProto" as Telegram
  cloud "Telegram Bot API\noptionaler Fallback" as TelegramBot
}

cloud "Mailcow / SMTP-Provider\nVerifizierungs- und Reset-Mails" as Mail

package "Web-Zugriff" {
  component "Traefik\nDockge / Produktion" as Traefik
  component "NGINX\nLokales Compose" as Nginx
  component "Next.js / React\nWeb-Dashboard" as Web
  component "Go API\nREST + Auth + Media" as API
}

package "Connector-Pools" {
  component "WhatsApp Connector\nNode.js + Baileys" as WAConnector
  component "WhatsApp Processing Worker\nrotierende Leases" as WAWorker
  component "WhatsApp Onboarding Slot\nQR-Pairing" as WAOnboarding
  component "Telegram Connector\nNode.js + GramJS/MTProto" as TGConnector
  component "Telegram Processing Worker\nrotierende Leases" as TGWorker
  component "Telegram Onboarding Slot\nQR-Login" as TGOnboarding
}

package "Event- und Verarbeitungsplattform" {
  queue "NATS JetStream\nWAGI_EVENTS" as NATS
  queue "NATS JetStream\nWAGI_REASSESSMENT" as ReassessmentNATS
  component "media-worker\nMinIO + OCR + whisper.cpp medium" as Media
  component "ai-worker\nHeuristik + Embeddings\noptional Hermes-Agent" as AI
  component "NATS Provisioner\nStreams + Durable Consumer" as Provisioner
}

package "Persistenz" {
  database "PostgreSQL\nPostGIS + pgvector" as DB
  storage "MinIO\nwa-media-images\nwa-media-videos\nwa-media-audio\nwa-media-documents\nwa-media-other" as MinIO
  folder "Shared media_data\nIncoming-Dateien" as MediaVolume
}

User --> Traefik : HTTPS\nProduktion
User --> Nginx : HTTP\nLokale Umgebung
Traefik --> Web : Host conxtor.com
Nginx --> Web : /
Nginx --> API : /api/\nHealth + Media
Web --> API : same-origin /api/*\nNext.js internal rewrite in Dockge

User --> Web : Login, Gruppen,\nConnector-Setup, Dashboard
User --> Web : /profile\nName, E-Mail, Passwort, Sprache
Admin --> Web : /admin\nNutzer anlegen, Rolle, Status
Admin --> Web : /admin/ai-learning\nKategorien, Zeitmetriken, Suche
Admin --> Web : /admin/ai-learning/{category}\nBegriffe, Bulk-Aktionen
API --> Mail : SMTP STARTTLS/TLS\nsprachabhängige Auth-Mails
Mail --> User : Verifizierungslink\nPasswort-Reset-Link

WhatsApp --> WAOnboarding : Linked Device / QR
WAOnboarding --> WAConnector : Baileys session
WAConnector --> WAWorker : account lease / rotation
WAWorker --> WhatsApp : selected groups\nBackfill + live receive

Telegram --> TGOnboarding : QR / MTProto Login
TGOnboarding --> TGConnector : GramJS session
TGConnector --> TGWorker : account lease / rotation
TGWorker --> Telegram : selected groups,\nSupergroups + Topics
TelegramBot ..> TGConnector : optional Bot API fallback

API --> DB : Auth, groups, accounts,\nselection, cursors, queries
API --> NATS : control events, audio jobs,\nfeedback, replay
API --> ReassessmentNATS : ai.reassessment.requested\nAdministrator-Job
API --> MediaVolume : signed media streaming

WAConnector --> DB : groups, messages,\nrevisions, contacts, cursors
TGConnector --> DB : dialogs, topics, messages,\ncursors
WAConnector --> NATS : wa.* + connector.*
TGConnector --> NATS : wa.* + connector.*

NATS --> Media : media.objects.requested\nmedia.audio.requested
Media --> MediaVolume : stage source / thumbnails
Media --> MinIO : original + thumbnail objects
Media --> DB : media_objects, audio_jobs
Media --> NATS : media.audio.transcribed\nmedia.image.analyzed\nmedia.document.analyzed

NATS --> AI : wa.messages.received\nmedia.*.analyzed\nreplay.requested
ReassessmentNATS --> AI : ai.reassessment.requested\nseparater Durable Consumer
AI --> DB : ai_jobs, message_analyses,\nknowledge hierarchy + graph,\nai_learning_terms
AI --> DB : ai_learning_term_history\ncreated, feedback, inferred, admin
AI --> NATS : ai.messages.analyzed\nDLQ bei Fehlern
AI ..> MinIO : optional document/media context
Provisioner --> NATS : WAGI_EVENTS,\nWAGI_* durable consumers
Provisioner --> ReassessmentNATS : WAGI_REASSESSMENT\nWAGI_AI_REASSESSMENT

note right of ReassessmentNATS
  Neubewertung liest nur persistierte
  Texte, Transkripte, OCR und Metadaten.
  Keine Medien- oder Connector-Jobs.
  Gedrosselt, damit Live-Verarbeitung
  unabhängig weiterlaufen kann.
end note

note right of WAConnector
  Gemeinsamer Connector-SDK-Lebenszyklus:
  start, stop, listGroups, status,
  einheitlicher Fehlervertrag.
  Auth-State wird als Snapshot in
  connector_accounts / connector_auth_state
  persistent gespeichert.
end note

note right of TGConnector
  Direkte Telegram-Verbindung ist Standard,
  Bot API bleibt als Fallback vorhanden.
  Nur ausgewählte Gruppen/Channels/Topics
  werden verarbeitet; Backfill nutzt Cursor
  und konfigurierbare Drosselung.
  Jeder vollständige Dialog-Snapshot entfernt
  verlassene Chats aus Auswahl und DB.
  Gemeinsame Chats bleiben für andere Nutzer
  erhalten; vollständig verwaiste Chats werden
  einschließlich Medien und Event-Payloads
  bereinigt.
end note

note right of Media
  Medientypen werden auf getrennte
  MinIO-Buckets geroutet. Buckets werden
  vor Upload und Cleanup idempotent geprüft
  und angelegt.
  Die API migriert Legacy-Objekte beim Start
  wiederaufnehmbar und aktualisiert
  media_objects.bucket.
  Es gibt keinen separaten Init-Container.
end note

note right of AI
  Ausschluss- und Füllwörter werden nicht
  mehr statisch im Code gepflegt. Globale
  Systembegriffe sowie gruppengebundene
  Lerngewichte kommen aus ai_learning_terms
  (Migrationen 014 und 015) und können
  sprachbezogen administriert werden.
end note

note bottom of DB
  Multi-User-Isolation über app_users,
  user_group_access und connector_accounts.
  connector_leases halten pro Account genau
  einen aktiven Worker; QR-Onboarding besitzt
  dedizierte Slots.
end note

note right of API
  Öffentliche Auth-Endpunkte:
  /auth/login, /auth/register,
  /auth/verify-email,
  /auth/password-reset/*.
  Neue Accounts erhalten erst nach
  erfolgreicher E-Mail-Verifizierung
  eine Dashboard-Session.
end note
@enduml
