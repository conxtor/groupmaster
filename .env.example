# WAGI local configuration example
# Copy this file to .env and replace credentials and tokens as needed.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
POSTGRES_USER=supabase_admin
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgres://wagi_app:app@localhost:5432/app?sslmode=disable

# -----------------------------------------------------------------------------
# NATS / JetStream
# -----------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
NATS_EVENT_MAX_AGE_DAYS=30
NATS_DLQ_MAX_AGE_DAYS=90
NATS_REASSESSMENT_MAX_AGE_DAYS=30
NATS_REASSESSMENT_ACK_WAIT_SECONDS=86400
NATS_THREAD_REASSESSMENT_MAX_AGE_DAYS=30
NATS_THREAD_REASSESSMENT_ACK_WAIT_SECONDS=86400
NATS_KB_REBUILD_MAX_AGE_DAYS=30
NATS_KB_REBUILD_ACK_WAIT_SECONDS=86400
NATS_MAX_DELIVERIES=5
NATS_RETRY_BASE_SECONDS=5
NATS_RETRY_MAX_SECONDS=300

# -----------------------------------------------------------------------------
# Application, browser and same-origin API routing
# -----------------------------------------------------------------------------
WAGI_PUBLIC_PORT=3000
WAGI_PUBLIC_URL=http://localhost:3000
WAGI_COOKIE_SECURE=false
# Empty for the default same-origin NGINX deployment. Set this only when a
# separate frontend or direct API client needs browser CORS access.
WAGI_CORS_ORIGIN=
WAGI_BOOTSTRAP_ADMIN_EMAIL=volker@kerkhoff.es
WAGI_BOOTSTRAP_ADMIN_NAME=Volker Kerkhoff
WAGI_BOOTSTRAP_ADMIN_PASSWORD=Ctas2025!
NEXT_PUBLIC_API_URL=

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# For Mailcow use the reachable SMTP hostname, usually submission port 587.
SMTP_ENABLED=false
SMTP_HOST=mailcow-mailcowdockerized-postfix-mailcow-1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@conxtor.com
SMTP_FROM_NAME=WAGI
SMTP_REPLY_TO=
EMAIL_VERIFICATION_HOURS=48
PASSWORD_RESET_HOURS=1

# -----------------------------------------------------------------------------
# MinIO / media storage
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
MINIO_ENDPOINT=http://localhost:9000
# The buckets are created idempotently by media-worker before first use.
MINIO_BUCKET=wa-media
MINIO_BUCKET_IMAGES=wa-media-images
MINIO_BUCKET_VIDEOS=wa-media-videos
MINIO_BUCKET_AUDIO=wa-media-audio
MINIO_BUCKET_DOCUMENTS=wa-media-documents
MINIO_BUCKET_OTHER=wa-media-other
MEDIA_BUCKET_MIGRATION_ENABLED=true
MEDIA_DIR=./data/media
MEDIA_SIGNING_SECRET=replace-with-a-random-signing-secret
MEDIA_CLEANUP_TOKEN=replace-with-a-random-secret

# -----------------------------------------------------------------------------
# Connector pool and scheduling
# -----------------------------------------------------------------------------
CONNECTOR_POOL_ENABLED=true
WA_CONNECTOR_POOL_SIZE=5
TG_CONNECTOR_POOL_SIZE=5
WA_ONBOARDING_SLOTS=1
TG_ONBOARDING_SLOTS=1
CONNECTOR_LEASE_SECONDS=90
CONNECTOR_ACCOUNT_SLOT_SECONDS=1800
CONNECTOR_SYNC_INTERVAL_SECONDS=300
CONNECTOR_START_DELAY_MS=5000
CONNECTOR_POOL_RETRY_DELAY_MS=20000
CONNECTOR_WORKER_ID=
WA_CONNECTOR_ACCOUNT_ID=
TG_CONNECTOR_ACCOUNT_ID=
GROUP_REFRESH_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# WhatsApp / whatsmeow
# -----------------------------------------------------------------------------
WA_BACKFILL_DAYS=7
WA_BACKFILL_THROTTLE_MS=250
WA_BACKFILL_GROUP_DELAY_MS=1500
WA_HISTORY_PAGE_SIZE=50
WA_HISTORY_REQUEST_DELAY_MS=500
WA_SYNC_GRACE_SECONDS=60
WA_WHATSMEOW_SQL_SCHEMA=wa_whatsmeow
WA_DATABASE_SSLMODE=disable
WA_MEDIA_DOWNLOAD_ATTEMPTS=3
WA_MEDIA_RETRY_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Telegram direct MTProto / gotd
# -----------------------------------------------------------------------------
TG_API_ID=
TG_API_HASH=
TG_STATE_DIR=./data/tg-state
TG_BACKFILL_DAYS=7
TG_BACKFILL_THROTTLE_MS=500
TG_BACKFILL_GROUP_DELAY_MS=2000

# -----------------------------------------------------------------------------
# AI core and semantic grouping
# -----------------------------------------------------------------------------
AI_MODEL=heuristic-mvp
AI_PROVIDER=hybrid
AI_ENDPOINT=
AI_API_KEY=
AI_PROMPT_VERSION=cascade-v5-places
AI_KNOWLEDGE_VERSION=cascade-v5-places
AI_CONTEXT_MAX_MESSAGES=80
AI_EVENT_WINDOW_HOURS=36
AI_EVENT_MIN_CONFIDENCE=0.70
AI_THREAD_WINDOW_HOURS=18
AI_THREAD_MAX_CANDIDATES=6
AI_THREAD_AUTO_LINK_THRESHOLD=0.50
AI_THREAD_CONTEXT_THRESHOLD=0.42
AI_SEMANTIC_DISCOVERY_THRESHOLD=0.90
AI_SEMANTIC_MERGE_THRESHOLD=0.18
AI_SEMANTIC_DISCOVERY_MARGIN=0.05

# -----------------------------------------------------------------------------
# AI embeddings / Hugging Face
# -----------------------------------------------------------------------------
AI_EMBEDDINGS_ENABLED=true
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
AI_EMBEDDING_CACHE_DIR=/root/.cache/fastembed
AI_HF_MODEL_LOAD_INTERVAL_SECONDS=86400
HF_TOKEN=
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_ETAG_TIMEOUT=10

# -----------------------------------------------------------------------------
# AI learning, retries and payload limits
# -----------------------------------------------------------------------------
AI_MAX_RETRIES=5
AI_STALE_PROCESSING_SECONDS=900
AI_REASSESSMENT_DELAY_MS=100
AI_DOCUMENT_ANALYSIS_MAX_CHARS=12000
AI_NATS_PAYLOAD_LIMIT_BYTES=900000
AI_LEARNING_INFERENCE_BASE_DELTA=0.003
AI_LEARNING_CONTEXT_BONUS=0.009
AI_LEARNING_MAX_DELTA=0.015
AI_LEARNING_MAX_TERMS_PER_SIGNAL=8
AI_KB_MIN_CONTENT_CHARS=48
AI_KB_MIN_CONTENT_TOKENS=6
AI_KB_MIN_STRONG_TERMS=2
AI_KB_MIN_SUPPORTING_TERMS=1
AI_KB_MAX_TOPICS_PER_MESSAGE=1
AI_KB_MIN_INFERRED_OCCURRENCES=2
AI_KB_MAX_INFERRED_TERMS_PER_TOPIC=2

# -----------------------------------------------------------------------------
# Hermes-Agent remote review (optional)
# -----------------------------------------------------------------------------
AI_HERMES_ENABLED=false
AI_HERMES_URL=
AI_HERMES_API_KEY=
AI_HERMES_MODEL=hermes-agent
AI_HERMES_TIMEOUT_MS=60000
AI_HERMES_CONNECT_TIMEOUT_MS=10000
AI_HERMES_RETRY_ATTEMPTS=3
AI_HERMES_RETRY_BASE_MS=1500
AI_HERMES_RETRY_MAX_MS=10000
AI_HERMES_FAILURE_COOLDOWN_SECONDS=60
AI_HERMES_REVIEW_ALL=false
AI_HERMES_MIN_CONFIDENCE=0.78

# -----------------------------------------------------------------------------
# Place detection and optional geocoding
# -----------------------------------------------------------------------------
# The built-in NER-lite detector remains active when no spaCy model is set.
AI_PLACE_NER_ENABLED=true
AI_PLACE_NER_MODEL=
AI_PLACE_MIN_CONFIDENCE=0.70
AI_PLACE_HERMES_ENABLED=true
AI_PLACE_HERMES_MIN_CONFIDENCE=0.78
AI_PLACE_LEARNING_MIN_CONFIDENCE=0.82
AI_PLACE_GEOCODER_ENABLED=false
AI_PLACE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
AI_PLACE_GEOCODER_USER_AGENT=wagi-place-resolver/1.0
AI_PLACE_GEOCODER_TIMEOUT_MS=5000
AI_PLACE_GEOCODER_THROTTLE_MS=1100
AI_PLACE_REQUIRE_GEOCODER=false

# -----------------------------------------------------------------------------
# Whisper.cpp and media processing
# -----------------------------------------------------------------------------
WHISPER_ENABLED=true
WHISPER_MODEL=medium
WHISPER_LANGUAGE=auto
WHISPER_LANGUAGES=es,ca,de,en,fr
WHISPER_THREADS=4
MEDIA_MAX_RETRIES=3
MEDIA_STALE_PROCESSING_SECONDS=900
MEDIA_ANALYSIS_EVENT_MAX_CHARS=12000
